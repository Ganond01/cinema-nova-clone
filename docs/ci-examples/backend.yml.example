# REFERENCE ONLY: not an active GitHub Actions workflow.
# Configure your own hosts, runner and registry before use.
name: Backend CI

on:
  push:
    branches: [dev, main]
  workflow_dispatch:

env:
  IMAGE_NAME: ghcr.io/YOUR_ACCOUNT/cinema-backend

jobs:
  build:
    runs-on: self-hosted
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      - name: Log in to GHCR
        run: echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin

      - name: Build image
        run: docker build -t $IMAGE_NAME:${{ github.ref_name }} -t $IMAGE_NAME:${{ github.sha }} -f Dockerfile.backend .

      - name: Push image
        run: |
          docker push $IMAGE_NAME:${{ github.ref_name }}
          docker push $IMAGE_NAME:${{ github.sha }}
